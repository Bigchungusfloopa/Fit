<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_water_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal">

    <!-- Header row: icon + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hydration"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:alpha="0.75" />

        <!-- Live refresh timestamp placeholder -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Big water reading -->
    <TextView
        android:id="@+id/widget_water_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0L"
        android:textColor="#FFFFFFFF"
        android:textSize="38sp"
        android:textStyle="bold"
        android:alpha="0.95"
        android:layout_marginBottom="2dp" />

    <!-- Glass count sub-label -->
    <TextView
        android:id="@+id/widget_water_glasses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 glasses"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:alpha="0.55"
        android:layout_marginBottom="10dp" />

    <!-- Glass progress bar — purple tint to match app accent -->
    <ProgressBar
        android:id="@+id/widget_water_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginBottom="14dp"
        android:progressTint="#7B61FF"
        android:progressBackgroundTint="#33FFFFFF"
        android:max="100"
        android:progress="0" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <TextView
            android:id="@+id/widget_water_remove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="− Glass"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:alpha="0.85"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:background="@drawable/widget_button_background"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/widget_water_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ Glass"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:alpha="0.85"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:background="@drawable/widget_button_background"
            android:layout_marginStart="5dp" />
    </LinearLayout>

</LinearLayout>